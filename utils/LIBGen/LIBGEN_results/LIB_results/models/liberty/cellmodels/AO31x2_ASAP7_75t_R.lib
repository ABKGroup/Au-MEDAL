        when : "(A1 * A2 * A3 * Y)" ; 
        related_pg_pin : VSS ; 

        rise_power(passive_power_template_7x1_x1) { 
          index_1("5, 10, 20, 40, 80, 160, 320");
          values("0.115874, 0.115985, 0.116285, 0.116114, 0.116938, 0.116357, 0.116042");
        }

        fall_power(passive_power_template_7x1_x1) { 
