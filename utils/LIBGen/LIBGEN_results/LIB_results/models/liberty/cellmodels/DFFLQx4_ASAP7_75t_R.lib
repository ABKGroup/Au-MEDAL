      internal_power() { 
        when : "!CLK" ; 
        related_pg_pin : VDD ; 

        rise_power(passive_power_template_7x1) { 
          index_1("5, 10, 20, 40, 80, 160, 320");
          values("-0.0371642, -0.0381295, -0.0388515, -0.0395038, -0.0395259, -0.0396865, -0.0399322");
        }

        fall_power(passive_power_template_7x1) { 
          index_1("5, 10, 20, 40, 80, 160, 320");
          values("0.0432073, 0.0433296, 0.0427021, 0.0423861, 0.0423353, 0.0421273, 0.0419431");
        }
      }

      internal_power() { 
        when : "!CLK" ; 
        related_pg_pin : VSS ; 

        rise_power(passive_power_template_7x1) { 
          index_1("5, 10, 20, 40, 80, 160, 320");
          values("0.0735537, 0.0719172, 0.0719771, 0.072152, 0.0714237, 0.0701798, 0.0698843");
        }

        fall_power(passive_power_template_7x1) { 
          index_1("5, 10, 20, 40, 80, 160, 320");
          values("-0.0660957, -0.066704, -0.0672248, -0.0672778, -0.0680469, -0.0680941, -0.0684532");
        }
      }
    }

    ff(IQ,IQN) { 
      clocked_on : "!CLK" ; 
      next_state : "D" ; 
      power_down_function : "(!VDD) + (VSS)" ; 
    }
  }
}
